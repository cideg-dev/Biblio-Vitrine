          <rdf:li>Christian</rdf:li>
          <rdf:li>Healing</rdf:li>
          <rdf:li>Prayer</rdf:li>
          <rdf:li>Body; Mind &amp; Spirit</rdf:li>
          <rdf:li>Fiction</rdf:li>
        </rdf:Bag>
      </dc:subject>
